{
  "name": "playwright-qa-ci",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + GitHub Actions: E2E, API/data checks, and CI quality gates against Practice Software Testing (Toolshop).",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test tests/api",
    "test:e2e": "playwright test tests/e2e",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "dotenv": "^16.4.7"
  }
}
